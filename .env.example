# Copy this file to .env before running docker compose:
#   cp .env.example .env
#
# These are LOCAL DEVELOPMENT values only. Replace every credential before using the
# solution anywhere else; .env is git-ignored so real values never reach the repository.

# --- PostgreSQL ---
POSTGRES_DB=maintenance
POSTGRES_USER=maintenance_user
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# --- API ---
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
# Origin allowed by CORS; must match the URL the browser uses for the frontend.
FRONTEND_ORIGIN=http://localhost:3000

# --- Authentication ---
# Key used to sign the access tokens (HMAC-SHA256), minimum 32 characters. The value below
# is a development placeholder and protects nothing: generate your own before deploying,
# for example with `openssl rand -base64 48`.
JWT_SIGNING_KEY=clave-de-desarrollo-local-cambiela-antes-de-desplegar
# How long a session lasts, in minutes (480 = 8 hours).
JWT_LIFETIME_MINUTES=480

# --- Frontend ---
WEB_PORT=3000
# URL the browser uses to reach the API (the host port published above).
NEXT_PUBLIC_API_URL=http://localhost:8080
