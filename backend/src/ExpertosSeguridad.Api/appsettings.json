{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "http://localhost:3000"
  },
  "Swagger": {
    "Enabled": true
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "expertos-seguridad-api",
    "Audience": "expertos-seguridad-web",
    "LifetimeMinutes": 480
  }
}
